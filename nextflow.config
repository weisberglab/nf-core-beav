/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/beav Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options: By default, store your files in ./inputFiles
    input                       = './inputFiles' // The file parser only reads depth 1, please use comma delimeted FULL paths if you want multiple files located in separate directories
    outdir                      = './results'    // Output directory
    beav_dir                    = './beavDB'     // The directory where all dependencies will be stored. It is recommended to only download this once per filesystem and make it accessible to all users.
    help                        = false          // Show help and exit
    h                           = false          // Show help and exit

    // Databases
    bakta_db                    = false      // Specify only if you have the databases saved somewhere else
    antismash_db                = false      
    tiger_blast_db              = false      // Required for tiger: Helps to confirm ICE insertions

    // Bakta Options
    force_bakta_annotation       = false     // If the CHECK_ANNOTATION_STATE module is incorrectly stating that files have already been Bakta annotated
    bakta_db_type                = 'light'   // 'full' (~80GB) or 'light' (~2GB)
    skip_bakta                   = false     // Debug

    // Debug options
        // Tiger and Gapmind are finicky and may produce errors, report bugs to the BEAV 2.0 GitHub page and skip them while we fix them
    skip_tiger                  = false
    skip_gapmind                = false

        // MacSyFinder and DefenseFinder run git operations internally. Too many runs in a row will prevent usage of them. Skip them if that happens
    skip_macsyfinder            = false
    skip_defensefinder          = false

        // Likely you will never have to skip these, but if they produce errors the options are here
    skip_antismash              = false
    skip_integronfinder         = false
    skip_phispy                 = false
    skip_sourmash               = false
    skip_blastn                 = false
    skip_hmmer                  = false
    skip_fuzznuc                = false
    skip_mobsuite               = false

        // Operon mapper submits a job to a website, and skips by default. Provide an email with this parameter to use it
    operon_email                = false

        // Agrobacterium specific pipeline
    agrobacterium               = false
    agro                        = false

    // Boilerplate options
    publish_dir_mode             = 'symlink'
    publish_intermediate_files   = false // specify true to see individual process intermediate output files
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// descriptions
params.description = [
    usage: 'Specify any of the following with --{parameter} [value]',
    help: 'Show this help message and exit.',
    input: 'Path to input genome(s). May be a single file, a directory of files, or a comma-delimited list of files. Default: ./inputFiles',
    outdir: 'Output directory. Default: ./results',
    beav_dir: 'Directory where dependencies and databases are stored. Default: ./beavDB',
    bakta_db: 'Path to BAKTA database(must be 6.0) if user has it installed somewhere already.',
    antismash_db: 'Path to antiSMASH database if user has it installed somewhere already.',
    tiger_blast_db: 'Path to BLAST database. Tiger will skip if unspecified.',
    skip_antismash: 'Skips detection of secondary metabolite clusters. Default: false',
    skip_integronfinder: 'Skips detection of integrons. Default: false',
    skip_phispy: 'Skips detection of prophages using PHISpy. Default: false',
    skip_tiger: 'Skips detection of ICE systems using TIGER. Default: false',
    skip_macsyfinder: 'Skips detection of macromolecular systems using MacSyFinder. Default: false',
    skip_defensefinder: 'Skips detection of defense systems. Default: false',
    skip_gapmind: 'Skips GapMind analysis for amino acid and carbon metabolism. Default: false',
    operon_email: 'An email is required to run operon mapper. Runs for a max of 120 minutes, sends results to email if not completed.',
    agrobacterium: 'Runs multiple agrobacterium specific searches. Default: false, alias: agro'
]

profiles {
    // Example profile(Use with -profile yourProfileName, edit to your liking or add a new profile with your name below it)
    yourProfileName{
        params{
            bakta_db = './path/to/your/bakta/db'
            outdir   = './my/results/path'
        }

        process {
            // set default options to use for all processes
            executor = 'slurm'

            // specify the name of a specific process to give more resources to
            withName: 'BAKTA_BAKTA' {
                memory  = 12.GB
                cpus    = 2
            }
        }

        conda{
            // configure conda options
            enabled = true
        }

        // if you want to use containers instead, edit them here
        docker.enabled = false
            // these two options do the same thing:
        singularity.enabled = false
        /*singularity{
            enabled = false
        }*/

        env {
            // set default environment variables
            SINGULARITY_CACHEDIR = "${System.getenv('TMPDIR')}/singularity_cache"
            MPLCONFIGDIR = "./matplotlib"
            FONTCONFIG_PATH = "./matplotlib/tmp"
        }

    }

    // CQLS Cluster Profile
    CQLS{
        params {
            tiger_blast_db = '/nfs7/BPP/Chang_Lab/sequencing/Illumina/sequenced_2019_03_11/Avitis/db/allagro_withncbi/fna/all/all.fna'
            beav_dir       = '/nfs7/BPP/Weisberg_Lab/projects/beavTests/beav_dir_repo'
            input          = '/nfs7/BPP/Weisberg_Lab/projects/beavTests/new_input'
            agro           = true
        }

        process {
            beforeScript = '''
                export APPTAINER_TMPDIR=/scratch
                export TMPDIR=/scratch
            '''
            executor    = 'slurm'
            clusterOptions = '-p bpp -A bpp'

            withName: 'BAKTA_BAKTA' {
                memory = 48.GB
                cpus   = 6
            }

            withName: 'DEFENSEFINDER_DEFENSEFINDER' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'MACSYFINDER_MACSYFINDER' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'GAPMIND_GAPMIND' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'MOBSUITE_RECON' {
                memory  = 32.GB
                cpus    = 4
            }

            withName: 'PHISPY' {
                memory  = 24.GB
                cpus    = 3
            }

        }

        executor {
            queueSize = 100  // max concurrent jobs
        }

        env {
            http_proxy = 'http://10.224.64.23:3128'
            https_proxy = 'http://10.224.64.23:3128'
            JAVA_TOOL_OPTIONS = '-Dhttp.proxyHost=10.224.64.23 -Dhttp.proxyPort=3128 -Dhttps.proxyHost=10.224.64.23 -Dhttps.proxyPort=3128'
            TMPDIR = "/scratch"
            APPTAINER_CACHEDIR = '/nfs7/BPP/Weisberg_Lab/projects/beavTests/apptainer_cache'
            APPTAINER_TMPDIR   = '/scratch'
            APPTAINER_BINDPATH = "/nfs7/BPP/Weisberg_Lab/projects/beavTests/apptainer_cache"
            MPLCONFIGDIR = "./matplotlib"
            FONTCONFIG_PATH = "./matplotlib/tmp"
            FC_CACHE_DIR = "./matplotlib/tmp"
        }

        conda.enabled = false
        docker.enabled = false

        apptainer {
            enabled = true
            autoMounts = true
            cacheDir = "/nfs7/BPP/Weisberg_Lab/projects/beavTests/apptainer_cache"
            envWhitelist = ['TMPDIR', 'APPTAINER_CACHEDIR', 'APPTAINER_BINDPATH', 'APPTAINER_TMPDIR']
            runOptions = '--unsquash -B /scratch'
        }

    }

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        params {
            tiger_blast_db = '/nfs7/BPP/Chang_Lab/sequencing/Illumina/sequenced_2019_03_11/Avitis/db/allagro_withncbi/fna/all/all.fna'
            beav_dir       = '/nfs7/BPP/Weisberg_Lab/projects/beavTests/beav_dir_repo'
            input          = '/nfs7/BPP/Weisberg_Lab/projects/beavTests/new_input'
            agro           = true
        }

        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda', 'defaults']
        apptainer.enabled       = false
        beforeScript = 'unset PYTHONPATH'
        process {
            executor    = 'slurm'

            withName: 'BAKTA_BAKTA' {
                memory = 48.GB
                cpus   = 6
            }

            withName: 'DEFENSEFINDER_DEFENSEFINDER' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'MACSYFINDER_MACSYFINDER' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'GAPMIND_GAPMIND' {
                memory  = 24.GB
                cpus    = 3
            }

            withName: 'MOBSUITE_RECON' {
                memory  = 32.GB
                cpus    = 4
            }

            withName: 'PHISPY' {
                memory  = 24.GB
                cpus    = 3
            }
        }
        
        executor.queueSize = 100

        env {
            http_proxy = 'http://10.224.64.23:3128'
            https_proxy = 'http://10.224.64.23:3128'
            JAVA_TOOL_OPTIONS = '-Dhttp.proxyHost=10.224.64.23 -Dhttp.proxyPort=3128 -Dhttps.proxyHost=10.224.64.23 -Dhttps.proxyPort=3128'
            MPLCONFIGDIR = "./matplotlib"
            FONTCONFIG_PATH = "./matplotlib/tmp"
            FC_CACHE_DIR = "./matplotlib/tmp"
            TMPDIR = "${System.getenv('TMPDIR')}/conda_cache"
        }
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/beav custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load nf-core/beav custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/beav.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/beav'
    contributors    = [
        [
            name: 'Ammon Larsen',
            affiliation: 'weisberglab, Oregon State University',
            email: 'larseamm@oregonstate.edu',
            github: 'amnalert',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Jewell Jung',
            affiliation: 'Weisberg Lab, Oregon State University',
            email: '',
            github: 'jewell-bug',
            contribution: ['author', 'contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Arafat Rahman',
            affiliation: '',
            email: '',
            github: 'acarafat',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Alexandra Weisberg',
            affiliation: 'Weisberg Lab, Oregon State University',
            email: '',
            github: 'alexweisberg',
            contribution: ['author', 'contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0002-0045-1368'
        ],
    ]
    homePage        = 'https://github.com/nf-core/beav'
    description     = """nf-core/beav(Bacterial Element Annotation reVamped) is a bioinformatics pipeline that takes bacteria sequences, either raw fasta sequences or from genbank, and annotates them to highlight bacterial elements. The output are 3 annotated sequece files in different common formats, and a Circos plot with the annotations shown. Tools specific to agrobacterium are also optionally available."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
